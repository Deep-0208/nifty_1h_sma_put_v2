[Unit]
Description=NIFTY 1-Hour SMA PUT Strategy v2 24/7 Launcher
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/home/azureuser/projects/nifty_1hr_sma_put_v2
ExecStart=/home/azureuser/projects/nifty_1hr_sma_put_v2/venv/bin/python /home/azureuser/projects/nifty_1hr_sma_put_v2/launcher.py
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
